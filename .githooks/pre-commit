#!/bin/sh
set -eu
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
staged=$(git diff --cached --name-only)
case "$branch" in
  main)
    if printf '%s\n' "$staged" | grep -Eq '^web/' &&
       printf '%s\n' "$staged" | grep '^web/' | grep -Ev '^web/(data/|export_[^/]+\.py$)' >/dev/null; then
      echo "UI changes belong on front-end." >&2
      exit 1
    fi ;;
  front-end)
    if ! git rev-parse --quiet --verify MERGE_HEAD >/dev/null &&
       printf '%s\n' "$staged" | grep -Eq '^(french_course/|web/(data/|export_[^/]+\.py$))'; then
      echo "Course and export changes belong on main." >&2
      exit 1
    fi ;;
esac
